:8000 {
    root * /srv

    # Forward API requests to the backend
    handle_path /api/* {
        reverse_proxy {
            header_up X-Real-IP {remote_host}
            dynamic a {
                name backend
                port 8000
            }
            lb_policy round_robin
        }
    }

    # Aggressively cache the Nuxt files since they are keyed on hash
    handle /_nuxt/* {
        header Cache-Control "public, immutable, max-age=31536000"
        file_server
    }

    handle {
        try_files {path} {path}/ /index.html
        file_server
    }
}
